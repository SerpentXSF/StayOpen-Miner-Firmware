# ESP-IDF build output
build/
sdkconfig.old
managed_components/
dependencies.lock

# Component manager cache
.component_hash

# Node / web UI
node_modules/
dist/
main/http_server/axe-os/dist/
main/http_server/axe-os/node_modules/
main/http_server/axe-os/test-results/
main/http_server/axe-os/playwright-report/

# Generated flash images
*.bin
!main/http_server/axe-os/public/**/*.bin
www.bin
config*.bin

# Provisioning: holds WiFi credentials, the API password and your payout
# address. Copy config.cvs.example and fill it in; never commit the result.
config*.cvs

# Signing keys. Losing these means never updating a Secure Boot device again.
secure/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# The web flasher still has to serve its image from its own origin -- release
# assets carry no CORS headers, so a browser cannot fetch one from the Pages
# site -- but that image does not belong on this branch. Every release put
# another 12 MB blob in the project's permanent history, where nothing could
# remove it afterwards.
#
# It lives on gh-pages instead, which tools/publish_flasher.py rewrites as a
# single orphan commit each time, so the previous image stops being referenced
# rather than accumulating. Keep the binaries out of here.
docs/flasher/*.bin

# Python bytecode from tools/
__pycache__/

# Never commit a live API password. One was tracked here from 26db064
# until it was noticed; treat anything that reached a public remote as
# compromised and change it on the device rather than only deleting it.
.api-password.txt
*api-password*

# Editor and assistant tooling. .claude/launch.json is a dev-server config
# with nothing private in it, but the directory name is the only place this
# public repository names the tools it was written with, and the project
# keeps that out of its commits, code and files. It stays on disk and keeps
# working; it just is not published.
.claude/
